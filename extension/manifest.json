{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://7tv.io/*",
    "https://api.ivr.fi/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/core.js",
      "lib/i18n.js",
      "lib/storage.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "css": [
        "content/style.css"
      ],
      "js": [
        "lib/core.js",
        "lib/i18n.js",
        "lib/ui.js",
        "lib/storage.js",
        "lib/seventv.js",
        "lib/settings-ui.js",
        "content/youtube.js",
        "content/input.js",
        "content/render.js",
        "content/tabcomplete.js",
        "content/guard.js",
        "content/modal.js",
        "content/prompt.js",
        "content/panel.js",
        "content/picker.js",
        "content/main.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-7tv-client@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
